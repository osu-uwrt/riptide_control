<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>riptide_mpc</name>
  <version>0.0.1</version>
  <description>Test MPC controller: drop-in replacement for complete_controller that predicts with the simulator's Fossen model.</description>

  <maintainer email="osu.uwrt@gmail.com">OSU UWRT</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>riptide_msgs2</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>

  <exec_depend>riptide_descriptions2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
